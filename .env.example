# Copy to .env (never committed). Used by docker compose and, if you export them, by the local apps.

# Claude API key for the /api/ask agent. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model for the query agent
LENS_MODEL=claude-opus-5

# Postgres password for the compose stack
POSTGRES_PASSWORD=lens

# Folder holding the videos you indexed; mounted read-only into the api container so /api/frame can grab stills
LENS_VIDEO_DIR=./samples

# For running the apps outside docker:
# LENS_CONNECTION_STRING=Host=localhost;Port=5433;Database=lens;Username=lens;Password=lens
# LENS_JSON_PATH=./data/lens.json
# LENS_FFMPEG_DIR=D:\Lens\tools\ffmpeg\bin
