# Copy to .env (never committed). Used by docker compose and, if you export them, by the local apps.

# Who answers questions: auto (database first, then local model, then Claude) | local | ollama | claude
LENS_PROVIDER=auto

# Local open model through Ollama (https://ollama.com). Optional; only used for questions the planner cannot parse.
LENS_OLLAMA_URL=http://localhost:11434
LENS_OLLAMA_MODEL=qwen2.5:3b

# Claude API key. Optional; only used when neither the planner nor the local model can answer.
# ANTHROPIC_API_KEY=sk-ant-...
LENS_MODEL=claude-opus-5

# Optional RAG mode: local embedding model and where the vector index lives
LENS_EMBED_MODEL=nomic-embed-text
LENS_VECTOR_INDEX_PATH=./data/lens-vectors

# Every question and the query that answered it, for training your own model. Empty disables.
LENS_ASK_LOG_PATH=./data/ask-log.jsonl

# Postgres password for the compose stack
POSTGRES_PASSWORD=lens

# Folder holding the videos you indexed; mounted read-only into the api container so /api/frame can grab stills
LENS_VIDEO_DIR=./samples

# For running the apps outside docker:
# LENS_CONNECTION_STRING=Host=localhost;Port=5433;Database=lens;Username=lens;Password=lens
# LENS_JSON_PATH=./data/lens.json
# LENS_FFMPEG_DIR=D:\Lens\tools\ffmpeg\bin
